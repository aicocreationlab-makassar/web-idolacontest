NEXT_PUBLIC_SITE_URL=https://idolacontest.my.id
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push admin notifications. Generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@idolacontest.my.id

NEXT_PUBLIC_INSTAGRAM_USERNAME=idola.contest
NEXT_PUBLIC_WHATSAPP_NUMBER=

REGION_API_BASE_URL=https://www.emsifa.com/api-wilayah-indonesia/v2
POSTAL_CODE_API_BASE_URL=

# Enable only behind a trusted reverse proxy which overwrites X-Forwarded-For.
# Vercel's X-Vercel-Forwarded-For is used automatically.
TRUST_PROXY=false

# Optional
SENTRY_DSN=

# Bootstrap admin (scripts/create-admin.mjs). Never commit the password.
ADMIN_EMAIL=admin@idolacontest.my.ud
ADMIN_PASSWORD=
